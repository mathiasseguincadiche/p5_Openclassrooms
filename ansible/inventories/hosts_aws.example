[webservers]
# Remplacez les IPs par celles de vos instances NGINX (Exercice 1)
# Exemple :
# 54.123.45.67 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/p5-key.pem
# 54.123.45.68 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/p5-key.pem

[all:vars]
ansible_python_interpreter=/usr/bin/python3
