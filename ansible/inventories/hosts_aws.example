[webservers]
# Remplacez les IPs par celles de vos instances NGINX (Exercice 1)
# Exemple :
# web1 ansible_host=203.0.113.10 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/p5-key
# web2 ansible_host=203.0.113.11 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/p5-key

[all:vars]
ansible_python_interpreter=/usr/bin/python3
