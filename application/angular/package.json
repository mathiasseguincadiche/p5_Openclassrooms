{
  "name": "p5-infrastructure-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration production",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "ng lint",
    "test:contract": "node --test tests/*.test.mjs",
    "test:unit": "ng test --watch=false",
    "pretest": "npm run typecheck",
    "test": "npm run test:contract && npm run test:unit",
    "security:dependencies": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "jsdom": "29.1.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.7"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "undici": "7.29.0"
  },
  "engines": {
    "node": "22.22.x",
    "npm": ">=10 <12"
  }
}
