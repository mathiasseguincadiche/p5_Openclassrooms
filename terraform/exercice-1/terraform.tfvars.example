# Copiez ce fichier en terraform.tfvars puis adaptez les valeurs.
aws_region   = "us-east-1"
ami_id       = null
instance_type = "t3.micro"

# Remplacez cette valeur par votre adresse IPv4 publique suivie de /32.
your_ip_cidr = "203.0.113.10/32"

key_name            = "p5-key"
ssh_public_key_path = "~/.ssh/p5-key.pub"
