# =============================================
# TEMPLATE : .dockerignore
# =============================================
# Ce fichier permet d'exclure des fichiers et dossiers lors de la construction
# d'une image Docker. Cela permet de :
# - Réduire la taille de l'image.
# - Accélérer le build.
# - Éviter de copier des fichiers sensibles.

# =============================================
# Système d'exploitation
# =============================================
.DS_Store
Thumbs.db

# =============================================
# Node.js
# =============================================
node_modules/
npm-debug.log*
.yarn/
.yarn/install-state.gz

# =============================================
# Python
# =============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =============================================
# Environnements virtuels
# =============================================
.env
.venv
env/
venv/
ENV/

# =============================================
# IDE / Editeurs de code
# =============================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# =============================================
# Git
# =============================================
.git/
.gitignore
.gitmodules

# =============================================
# Logs et fichiers temporaires
# =============================================
*.log
*.tmp
*.temp
.cache/

# =============================================
# Docker
# =============================================
Dockerfile*
docker-compose*.yml
.docker/

# =============================================
# Documentation
# =============================================
*.md
LICENSE
README.md

# =============================================
# Build et artefacts
# =============================================
dist/
build/
target/

# =============================================
# Fichiers de configuration locaux
# =============================================
.env.local
.env.*.local

# =============================================
# Terraform
# =============================================
.terraform/
*.tfstate
*.tfstate.*

# =============================================
# Kubernetes
# =============================================
.kube/

# =============================================
# Ansible
# =============================================
ansible.cfg
inventory/

# =============================================
# EXPLICATIONS :
# =============================================
# - Chaque ligne est un motif de fichier/dossier à ignorer.
# - Les motifs peuvent utiliser des jokers (*).
# - Les dossiers se terminent par /.
# - Les commentaires commencent par #.
# =============================================

# =============================================
# UTILISATION :
# 1. Copiez ce fichier dans votre projet sous le nom ".dockerignore".
# 2. Personnalisez-le selon vos besoins.
# 3. Construisez votre image Docker :
#    docker build -t mon-app .
# =============================================
