# Configuration locale du contrôle AWS du P5.
# Ce modèle est copié automatiquement par configure-lab.sh.
# Ce fichier ne doit contenir aucune clé d'accès AWS et ne doit pas être commité.

AWS_PROFILE=p5-lab
AWS_REGION=us-east-1

# Authentification temporaire.
# auto réutilise une session valide, la renouvelle si possible, puis propose :
# - console : aws login --remote avec vos identifiants de console AWS ;
# - sso : IAM Identity Center ;
# - existing : profil temporaire existant.
P5_AWS_AUTH_MODE=auto
P5_AWS_LOGIN_PROFILE=p5-signin

# Compte AWS dans lequel le P5 est autorisé à créer des ressources.
P5_EXPECTED_ACCOUNT_ID=000000000000

# Adresse IPv4 publique actuelle du poste de lab, obligatoirement en /32.
P5_PUBLIC_IP_CIDR=203.0.113.10/32

# Ressources utilisées par les modules Terraform.
# Laisser P5_AMI_ID vide pour sélectionner automatiquement Ubuntu 24.04 LTS.
P5_AMI_ID=
P5_EC2_INSTANCE_TYPE=t3.micro
P5_KEY_NAME=p5-key
P5_SSH_PUBLIC_KEY_PATH=~/.ssh/p5-key.pub
P5_OPENSEARCH_INSTANCE_TYPE=t3.small.search
P5_OPENSEARCH_ENGINE=OpenSearch_2.19
P5_OPENSEARCH_DOMAIN=p5-opensearch
P5_OPENSEARCH_VOLUME_SIZE_GB=10

# L'exercice 1 et l'exercice 3 peuvent totaliser quatre t3.micro, soit 8 vCPU.
P5_REQUIRED_STANDARD_VCPUS=8

# Garde-fou de coût créé volontairement avec setup-aws-guardrails.sh --apply.
P5_BUDGET_NAME=p5-lab-monthly
P5_BUDGET_LIMIT_USD=20
P5_BUDGET_EMAIL=remplacer@example.com

# Bonnes pratiques. Le mode strict refuse les identifiants statiques lorsque
# cette valeur est à yes.
P5_REQUIRE_TEMPORARY_CREDENTIALS=yes

# Confirmations manuelles impossibles à prouver de manière fiable depuis la CLI.
# Remplacer no par yes uniquement après vérification dans la console AWS.
P5_ROOT_MFA_CONFIRMED=no
P5_ROOT_ACCESS_KEYS_ABSENT_CONFIRMED=no
P5_IAM_POLICY_ATTACHED_CONFIRMED=no
P5_BILLING_CONTACTS_CONFIRMED=no
