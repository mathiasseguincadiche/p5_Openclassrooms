# Contrat de référence du runtime P5 exécuté dans Ubuntu 26.04 sous WSL2.
# Windows, WSL2, le VHDX et la stack DevOps commune sont possédés par
# Windows_11_Pro_Custom. Ce fichier fixe les exigences propres au P5.
P5_UBUNTU_VERSION_ID=26.04
P5_UBUNTU_CODENAME=resolute
P5_EXPECTED_WSL_DISTRO=Ubuntu
P5_WSL_SOURCE_DISTRIBUTION=Ubuntu-26.04
P5_EXECUTION_MODEL=windows11-wsl2-ubuntu-26.04
P5_PLATFORM_REPOSITORY=mathiasseguincadiche/Windows_11_Pro_Custom
P5_WINDOWS_WSL_INSTALL_LOCATION='E:\WSL\Ubuntu-DevOps'
P5_ALLOWED_WORK_ROOTS='projects labs repositories'
P5_FORBIDDEN_MOUNT_PREFIXES='/mnt/c /mnt/e'
P5_EXPECTED_HOME_FILESYSTEM=ext4
P5_REQUIRE_SYSTEMD=true
P5_OPENSEARCH_MAX_MAP_COUNT=262144
NVM_VERSION=v0.40.4
NVM_COMMIT=62387b8f92aa012d48202747fd75c40850e5e261
NODE_VERSION=22.22.0
ANSIBLE_CORE_VERSION=2.20.1
ANSIBLE_CORE_SPEC="ansible-core==${ANSIBLE_CORE_VERSION}"
TERRAFORM_VERSION=1.15.8
TERRAFORM_MIN_VERSION=1.15.0
AWS_CLI_MIN_VERSION=2.32.0
OPENSEARCH_DOCKER_VERSION=2.19.6
NGINX_DOCKER_IMAGE=nginx:1.28-alpine
HAPROXY_DOCKER_IMAGE=haproxy:3.2-alpine
