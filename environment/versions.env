# Contrat de référence du runtime P5 exécuté dans la VM Ubuntu Server 26.04.
# La VM et sa virtualisation sont possédées par Ubuntu-desktops-custom ;
# ce fichier fixe uniquement les exigences propres au P5 à l'intérieur de la VM.
P5_UBUNTU_VERSION_ID=26.04
P5_UBUNTU_CODENAME=resolute
P5_EXPECTED_VM_NAME=ubuntu-devops
P5_EXECUTION_MODEL=ubuntu-server-kvm-vm
P5_PLATFORM_REPOSITORY=mathiasseguincadiche/Ubuntu-desktops-custom
NVM_VERSION=v0.40.4
NODE_VERSION=22.22.0
ANSIBLE_CORE_VERSION=2.20.1
ANSIBLE_CORE_SPEC="ansible-core==${ANSIBLE_CORE_VERSION}"
TERRAFORM_VERSION=1.15.8
TERRAFORM_MIN_VERSION=1.15.0
AWS_CLI_MIN_VERSION=2.32.0
OPENSEARCH_DOCKER_VERSION=2.19.6
NGINX_DOCKER_IMAGE=nginx:1.28-alpine
HAPROXY_DOCKER_IMAGE=haproxy:3.2-alpine
