# Copier ce fichier vers %UserProfile%\.wslconfig sous Windows.
# Les limites s'appliquent a la VM WSL2 globale et sont partagees entre
# toutes les distributions WSL2 actives.

[wsl2]
memory=16GB
processors=6
swap=8GB
networkingMode=nat
localhostForwarding=true
dnsTunneling=true
firewall=true
autoProxy=true
