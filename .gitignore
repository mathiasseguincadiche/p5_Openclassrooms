# =============================================================================
# .gitignore pour le projet P5 OpenClassrooms
# =============================================================================

# --- Fichiers temporaires et logs ---
*.log
*.swp
*.tmp
.DS_Store
Thumbs.db

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
terraform.lock.hcl

# --- Ansible ---
ansible.cfg
.inventory
.ansible-tmp
ansible.log
ansible/roles/

# --- Environnement ---
.env
.env.*
*.local

# --- Logs ---
logs/

# --- Dossiers de build et cache ---
/.cache/

# --- Fichiers de dépendances (Node.js, Python, etc.) ---
/node_modules/
/package-lock.json
/__pycache__/
*.pyc

# --- Fichiers IDE ---
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# --- Fichiers générés automatiquement ---
*.pyc
__pycache__/

# --- Fichiers de test ou exemples non nécessaires ---
/test/
/venv/

# --- Fichiers de logs et captures ---
*.png
*.jpg
*.jpeg
*.gif
*.bmp

# --- Fichiers de backup ou temporaires ---
*.bak
*.backup
*.old

# --- Fichiers de configuration système ---
*.conf.bak
*.conf.old
